datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  WORKER
  EMPLOYER
  CONTRACTOR
  ADMIN
  MODERATOR
}

enum BudgetType {
  FIXED
  DAILY
  HOURLY
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum JobStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  DISPUTED
  TERMINATED
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
  DISPUTED
}

enum PaymentChannel {
  MPESA
  AIRTEL_MONEY
  BANK
  CARD
}

enum TransactionType {
  DEPOSIT
  ESCROW_PAYMENT
  RELEASE
  WITHDRAWAL
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  VOICE_NOTE
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  phone            String            @unique
  passwordHash     String
  fullName         String
  role             Role              @default(WORKER)
  isVerified       Boolean           @default(false)
  isActive         Boolean           @default(true)
  avatarUrl        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  refreshTokens    RefreshToken[]
  workerProfile    WorkerProfile?
  employerProfile  EmployerProfile?
  contractorProfile ContractorProfile?
  postedJobs       Job[]             @relation("EmployerJobs")
  applications     JobApplication[]
  contractsAsWorker Contract[]       @relation("WorkerContracts")
  contractsAsEmployer Contract[]     @relation("EmployerContracts")
  transactions     PaymentTransaction[]
  sentMessages     Message[]         @relation("SentMessages")
  participants     ConversationParticipant[]
  notifications    Notification[]
  reviewsGiven     Review[]          @relation("ReviewsGiven")
  reviewsReceived  Review[]          @relation("ReviewsReceived")
  reportsFiled     Report[]          @relation("ReporterUser")
  reportsTargeted  Report[]          @relation("ReportedUser")
  auditLogs        AuditLog[]
  savedWorkers     SavedWorker[]     @relation("EmployerSavedWorkers")
  savedByEmployers SavedWorker[]     @relation("WorkerSavedBy")
  savedJobs        SavedJob[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model County {
  id          String       @id @default(uuid())
  name        String       @unique
  code        Int          @unique
  subCounties SubCounty[]
  workers     WorkerProfile[]
  employers   EmployerProfile[]
  jobs        Job[]
}

model SubCounty {
  id        String   @id @default(uuid())
  name      String
  countyId  String
  county    County   @relation(fields: [countyId], references: [id], onDelete: Cascade)
  wards     Ward[]
  workers   WorkerProfile[]
  employers EmployerProfile[]
  jobs      Job[]

  @@unique([name, countyId])
}

model Ward {
  id          String    @id @default(uuid())
  name        String
  subCountyId String
  subCounty   SubCounty @relation(fields: [subCountyId], references: [id], onDelete: Cascade)
  workers     WorkerProfile[]
  employers   EmployerProfile[]
  jobs        Job[]

  @@unique([name, subCountyId])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  skills      Skill[]
  jobs        Job[]
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  workerSkills WorkerSkill[]
  jobSkills    JobSkill[]
}

model WorkerProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationalId          String?  @unique
  isIdVerified        Boolean  @default(false)
  isPhoneVerified     Boolean  @default(false)
  isEmailVerified     Boolean  @default(false)
  bio                 String?
  yearsExperience     Int      @default(1)
  hourlyRate          Float    @default(0)
  dailyRate           Float    @default(0)
  travelRadiusKm      Float    @default(15)
  emergencyAvailable Boolean  @default(false)
  trustScore          Float    @default(80.0)
  responseTimeMinutes Int      @default(30)
  isAvailable         Boolean  @default(true)
  portfolioPhotos     String[] @default([])
  languages           String[] @default(["Swahili", "English"])
  
  countyId            String?
  county              County?    @relation(fields: [countyId], references: [id])
  subCountyId         String?
  subCounty           SubCounty? @relation(fields: [subCountyId], references: [id])
  wardId              String?
  ward                Ward?      @relation(fields: [wardId], references: [id])
  latitude            Float?
  longitude           Float?

  skills              WorkerSkill[]
  badges              WorkerBadge[]
}

model EmployerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName      String?
  organizationType String?  @default("Individual")
  contactPerson    String?
  countyId         String?
  county           County?    @relation(fields: [countyId], references: [id])
  subCountyId      String?
  subCounty        SubCounty? @relation(fields: [subCountyId], references: [id])
  wardId           String?
  ward             Ward?      @relation(fields: [wardId], references: [id])
}

model ContractorProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String
  registrationNumber String?
  projectsCount      Int      @default(0)
}

model WorkerSkill {
  id               String        @id @default(uuid())
  workerProfileId  String
  workerProfile    WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  skillId          String
  skill            Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  yearsExperience  Int           @default(1)
  proficiencyLevel String        @default("INTERMEDIATE")

  @@unique([workerProfileId, skillId])
}

model Job {
  id               String       @id @default(uuid())
  title            String
  description      String
  employerId       String
  employer         User         @relation("EmployerJobs", fields: [employerId], references: [id], onDelete: Cascade)
  categoryId       String
  category         Category     @relation(fields: [categoryId], references: [id])
  budgetType       BudgetType   @default(DAILY)
  budgetAmount     Float
  startDate        DateTime
  endDate          DateTime?
  numWorkersNeeded Int          @default(1)
  genderPreference String?      @default("ANY")
  experienceLevel  String       @default("ENTRY")
  urgency          UrgencyLevel @default(MEDIUM)
  status           JobStatus    @default(OPEN)

  countyId         String?
  county           County?      @relation(fields: [countyId], references: [id])
  subCountyId      String?
  subCounty        SubCounty?   @relation(fields: [subCountyId], references: [id])
  wardId           String?
  ward             Ward?        @relation(fields: [wardId], references: [id])
  address          String?
  latitude         Float?
  longitude        Float?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  skills           JobSkill[]
  applications     JobApplication[]
  contracts        Contract[]
  conversations    Conversation[]
  savedByWorkers   SavedJob[]
}

model JobSkill {
  id      String @id @default(uuid())
  jobId   String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
}

model JobApplication {
  id           String            @id @default(uuid())
  jobId        String
  job          Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId     String
  worker       User              @relation(fields: [workerId], references: [id], onDelete: Cascade)
  proposedRate Float
  coverLetter  String?
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([jobId, workerId])
}

model Contract {
  id           String         @id @default(uuid())
  jobId        String
  job          Job            @relation(fields: [jobId], references: [id])
  employerId   String
  employer     User           @relation("EmployerContracts", fields: [employerId], references: [id])
  workerId     String
  worker       User           @relation("WorkerContracts", fields: [workerId], references: [id])
  totalAmount  Float
  status       ContractStatus @default(ACTIVE)
  startDate    DateTime       @default(now())
  endDate      DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  escrow       EscrowAccount?
  reviews      Review[]
}

model EscrowAccount {
  id         String       @id @default(uuid())
  contractId String       @unique
  contract   Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  amount     Float
  status     EscrowStatus @default(HELD)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model PaymentTransaction {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  amount          Float
  currency        String            @default("KES")
  channel         PaymentChannel    @default(MPESA)
  transactionType TransactionType
  referenceNumber String            @unique
  status          TransactionStatus @default(PENDING)
  createdAt       DateTime          @default(now())
}

model Conversation {
  id           String                    @id @default(uuid())
  jobId        String?
  job          Job?                      @relation(fields: [jobId], references: [id])
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  content        String
  type           MessageType  @default(TEXT)
  attachmentUrl  String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model Review {
  id                  String   @id @default(uuid())
  contractId          String
  contract            Contract @relation(fields: [contractId], references: [id])
  reviewerId          String
  reviewer            User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId          String
  reviewee            User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  rating              Float
  comment             String?
  punctualityRating   Float?   @default(5.0)
  qualityRating       Float?   @default(5.0)
  communicationRating Float?   @default(5.0)
  createdAt           DateTime @default(now())
}

model Badge {
  id          String        @id @default(uuid())
  name        String        @unique
  code        String        @unique
  description String
  icon        String
  workers     WorkerBadge[]
}

model WorkerBadge {
  id              String        @id @default(uuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  badgeId         String
  badge           Badge         @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt       DateTime      @default(now())

  @@unique([workerProfileId, badgeId])
}

model Report {
  id             String        @id @default(uuid())
  reporterId     String
  reporter       User          @relation("ReporterUser", fields: [reporterId], references: [id])
  reportedUserId String
  reportedUser   User          @relation("ReportedUser", fields: [reportedUserId], references: [id])
  jobId          String?
  reason         String
  details        String?
  status         DisputeStatus @default(OPEN)
  resolution     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model SavedWorker {
  id         String   @id @default(uuid())
  employerId String
  employer   User     @relation("EmployerSavedWorkers", fields: [employerId], references: [id], onDelete: Cascade)
  workerId   String
  worker     User     @relation("WorkerSavedBy", fields: [workerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([employerId, workerId])
}

model SavedJob {
  id        String   @id @default(uuid())
  workerId  String
  worker    User     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([workerId, jobId])
}
