# MicroJob Enterprise Environment Variables Template

# PostgreSQL Database Connection
DATABASE_URL="postgresql://microjob:microjobpassword2026@localhost:5432/microjob_db?schema=public"

# Redis Cache & WebSockets
REDIS_HOST="localhost"
REDIS_PORT=6379

# NestJS API Server Settings
PORT=5000
JWT_SECRET="super-secret-microjob-key-2026"
